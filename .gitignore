# ============================================================
# sEMG Lower-Limb Movement Recognition — MSc Thesis Project
# .gitignore
# ============================================================

# ── RAW DATASET (25 GB) ──────────────────────────────────────
# Original SIAT-LLMD recordings — too large and proprietary for version control
SIAT_LLMD20230404/

# ── WINDOWED NPZ FILES AT PROJECT ROOT (400 MB+ each) ───────
# Generated by preprocess_emg.py — too large for GitHub (>100 MB limit)
windows_WAK_UPS_DNS_STDUP_v1_w150_ov50_conf60_AorR.npz
windows_WAK_UPS_DNS_STDUP_v1_w250_ov50_conf60_AorR.npz

# ── PYTHON CACHE ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── VIRTUAL ENVIRONMENTS ─────────────────────────────────────
venv/
env/
.env/
.venv/
*.egg-info/
dist/
build/

# ── JUPYTER NOTEBOOKS CHECKPOINTS ───────────────────────────
.ipynb_checkpoints/

# ── EDITOR / OS JUNK ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ── NESTED GIT REPO (placeholder only — no code) ────────────
# emg-stride-thesis/ was a previous Git init attempt; its content
# (LICENSE, README) is superseded by this repo's root-level files.
emg-stride-thesis/

# ── EDITOR / TOOL SESSION DATA ───────────────────────────────
.claude/

# ── LARGE LOG FILES ─────────────────────────────────────────
*.log
pipeline_log.txt

# ── RAW EMG PLOTS (183 MB — regenerable from batch_save_plot.py) ─
plots/

# NOTE: features_out/*.npz (3–9 MB each) ARE tracked — they are derived
# feature matrices small enough for GitHub and useful for reproducibility.
# results_*/predictions/ .npy files are tracked (< 1 MB total).

# ── RAW ENABL3S DEPOSIT (24 GB, added 30 Aug 2026) ──────────
# Figshare deposit 5362627: AB*.zip per-subject archives, ten of them
# individually over GitHub's 100 MB file limit. Obtain from the original
# authors (Hu, Rouse & Hargrove, 2018) rather than from this repo.
5362627/

# ── ENABL3S WINDOWED NPZ (292 MB) ───────────────────────────
# Same policy as the SIAT windowed npz above: the windowed array is too
# large for GitHub, while the DERIVED feature matrices beside it
# (features_out_ext/*_features_*.npz, 2-7 MB) ARE tracked.
features_out_ext/windows_ENABL3S_WAK_UPS_DNS_STDUP_w250_ov50_conf60.npz

# ── SECOND VERIFICATION VENV ────────────────────────────────
.venv-verify/

# ── ENABL3S PER-SUBJECT STAGING CHECKPOINTS (293 MB) ────────
# Intermediate per-subject windowed arrays written by adapt_external_dataset.py
# on its way to the derived feature matrices. Regenerable, and the derived
# matrices beside them are what the pipeline actually consumes.
features_out_ext/checkpoints/
